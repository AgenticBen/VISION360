{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/f/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assessment(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/directory",
      "destination": "/directory/index.html"
    },
    {
      "source": "/f/:flow",
      "destination": "/demo/index.html"
    },
    {
      "source": "/f/:flow/",
      "destination": "/demo/index.html"
    },
    {
      "source": "/assessment",
      "destination": "/demo/index.html"
    },
    {
      "source": "/assessment/",
      "destination": "/demo/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/api/v360?__path=/admin/"
    },
    {
      "source": "/admin/:path*/",
      "destination": "/api/v360?__path=/admin/:path*/"
    },
    {
      "source": "/admin",
      "destination": "/api/v360?__path=/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/v360?__path=/admin/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/v360?__path=/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/v360?__path=/.well-known/oauth-protected-resource/:path*"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/v360?__path=/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/v360?__path=/.well-known/oauth-authorization-server/:path*"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/v360?__path=/.well-known/openid-configuration"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/v360?__path=/oauth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/v360?__path=/api/:path*"
    }
  ],
  "functions": {
    "api/v360.mjs": {
      "includeFiles": "{site/data/**,site/quiz-engine.js,site/voice-phrases.js,server/**,admin/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/staff",
      "destination": "/admin/conversations/",
      "permanent": false
    },
    {
      "source": "/staff/",
      "destination": "/admin/conversations/",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 10 * * *"
    }
  ]
}
