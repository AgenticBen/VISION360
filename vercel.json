{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "site",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/admin/conversations",
      "destination": "/admin/conversations/index.html"
    },
    {
      "source": "/admin/emails",
      "destination": "/admin/emails/index.html"
    },
    {
      "source": "/admin/costs",
      "destination": "/admin/costs/index.html"
    },
    {
      "source": "/admin/workflows",
      "destination": "/admin/workflows/index.html"
    },
    {
      "source": "/admin/data",
      "destination": "/admin/data/index.html"
    },
    {
      "source": "/admin/requests",
      "destination": "/admin/requests/index.html"
    },
    {
      "source": "/admin/changelog",
      "destination": "/admin/changelog/index.html"
    },
    {
      "source": "/admin/settings",
      "destination": "/admin/settings/index.html"
    },
    {
      "source": "/admin/workflows/edit",
      "destination": "/admin/workflows/edit/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/v360?__path=/api/:path*"
    }
  ],
  "functions": {
    "api/v360.mjs": {
      "includeFiles": "{site/data/**,site/quiz-engine.js,server/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/staff",
      "destination": "/admin/conversations/",
      "permanent": false
    },
    {
      "source": "/staff/",
      "destination": "/admin/conversations/",
      "permanent": false
    }
  ]
}
